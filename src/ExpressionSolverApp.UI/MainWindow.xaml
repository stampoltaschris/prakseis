<Window x:Class="ExpressionSolverApp.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ExpressionSolverApp.UI.Controls"
        mc:Ignorable="d"
        Title="Επιλυτής &amp; Οπτικοποιητής Μαθηματικών &amp; Λογικών Παραστάσεων (Λυκείου)"
        Height="800" Width="1280" MinWidth="1024" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A">

    <Window.Resources>
        <!-- Modern Card Style -->
        <Style x:Key="CardPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <!-- Primary Accent Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4F46E5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#6366F1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4338CA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#334155" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#475569" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#475569" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Side Navigation Button Style -->
        <Style x:Key="NavButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B" />
                                <Setter Property="Foreground" Value="#F8FAFC" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#312E81" />
                                <Setter Property="Foreground" Value="#818CF8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" /> <!-- Left Side Menu -->
            <ColumnDefinition Width="*" />   <!-- Main Content -->
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDE MENU / MODE SELECTOR -->
        <Border Grid.Column="0" Style="{StaticResource CardPanelStyle}" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- App Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Math &amp; Logic Visualizer" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="Επιλυτής Παραστάσεων Λυκείου" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Mode Selection Header -->
                <TextBlock Grid.Row="1" Text="ΛΕΙΤΟΥΡΓΙΑ PEDAGOGY" Foreground="#64748B" FontSize="11" FontWeight="Bold" Margin="4,8,4,6"/>

                <!-- Pedagogy Mode Radio Buttons -->
                <StackPanel Grid.Row="2" Margin="0,0,0,16">
                    <RadioButton x:Name="RbArithmeticMode" Style="{StaticResource NavButtonStyle}" Content="1. Αριθμητική Λειτουργία" IsChecked="True" Checked="OnModeChanged"/>
                    <RadioButton x:Name="RbLogicalMode" Style="{StaticResource NavButtonStyle}" Content="2. Πλήρης / Λογική" Checked="OnModeChanged"/>
                </StackPanel>

                <!-- Preset Examples Panel -->
                <StackPanel Grid.Row="3">
                    <TextBlock Text="ΠΑΡΑΔΕΙΓΜΑΤΑ" Foreground="#64748B" FontSize="11" FontWeight="Bold" Margin="4,8,4,6"/>
                    <ComboBox x:Name="CmbPresets" Background="#0F172A" Foreground="White" FontSize="13" Padding="8,6" Margin="0,4" SelectionChanged="OnPresetSelected"/>
                </StackPanel>

                <!-- Footer Info -->
                <StackPanel Grid.Row="4" Margin="0,16,0,0">
                    <Separator Background="#334155" Margin="0,0,0,12"/>
                    <TextBlock Text="Shunting-Yard Parser &amp; AST Engine" Foreground="#64748B" FontSize="11" TextAlignment="Center"/>
                    <TextBlock Text=".NET 8 Fluent Design" Foreground="#475569" FontSize="10" TextAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN DASHBOARD CONTENT -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Top Bar (Input & Validation) -->
                <RowDefinition Height="*" />    <!-- Visual Tree AST & Steps Panel -->
                <RowDefinition Height="Auto" /> <!-- Playback Bar -->
                <RowDefinition Height="Auto" /> <!-- Virtual Touch Keyboard Panel -->
            </Grid.RowDefinitions>

            <!-- TOP INPUT & VALIDATION PANEL -->
            <Border Grid.Row="0" Style="{StaticResource CardPanelStyle}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Εισαγωγή Παράστασης:" Foreground="#94A3B8" FontSize="12" Margin="2,0,0,4"/>
                        <TextBox x:Name="TxtExpression" Background="#0F172A" Foreground="#F8FAFC" FontSize="16" FontWeight="SemiBold" Padding="10,8" BorderThickness="1" BorderBrush="#334155" KeyDown="OnExpressionKeyDown"/>

                        <!-- Validation Badge / Status Indicator -->
                        <Border x:Name="BadgeValidation" Margin="2,6,0,0" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Background="#064E3B">
                            <TextBlock x:Name="TxtValidationStatus" Text="✓ Έτοιμο για υπολογισμό" Foreground="#34D399" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <!-- Solve Button -->
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Margin="12,20,0,0" VerticalAlignment="Top" Click="OnSolveClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" Margin="0,0,6,0" FontSize="15"/>
                            <TextBlock Text="Επίλυση &amp; Οπτικοποίηση"/>
                        </StackPanel>
                    </Button>

                    <!-- Toggle Virtual Keyboard Button -->
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Margin="8,20,0,0" VerticalAlignment="Top" Click="OnToggleKeyboardClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌨" Margin="0,0,6,0" FontSize="14"/>
                            <TextBlock Text="Πληκτρολόγιο"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- MIDDLE SECTION: VISUAL AST TREE & HIERARCHY BREAKDOWN -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*" /> <!-- Visual Canvas AST Tree -->
                    <ColumnDefinition Width="1*" />   <!-- Priority Hierarchy & Steps Breakdown -->
                </Grid.ColumnDefinitions>

                <!-- Visual AST Canvas Card -->
                <Border Grid.Column="0" Style="{StaticResource CardPanelStyle}" Margin="0,0,6,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="🌳" FontSize="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Visual Expression Tree (AST)" Foreground="White" FontSize="15" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtStepCounter" Text="(Βήμα 0 / 0)" Foreground="#F59E0B" FontSize="13" FontWeight="SemiBold" Margin="12,2,0,0"/>
                        </StackPanel>

                        <!-- AST Canvas -->
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#0B1120">
                            <controls:AstCanvas x:Name="AstCanvasControl" MinWidth="500" MinHeight="350"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Hierarchy Rules Breakdown Panel -->
                <Border Grid.Column="1" Style="{StaticResource CardPanelStyle}" Margin="6,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="📜" FontSize="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Ιεραρχία &amp; Κανόνες Προτεραιότητας" Foreground="White" FontSize="15" FontWeight="Bold"/>
                        </StackPanel>

                        <!-- Active Step Rule Box -->
                        <Border Grid.Row="1" Background="#311B92" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderThickness="1" BorderBrush="#6366F1">
                            <StackPanel>
                                <TextBlock x:Name="TxtRuleCategory" Text="Κανόνας Εκτέλεσης" Foreground="#A5B4FC" FontSize="11" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtExplanation" Text="Εισάγετε μια παράσταση και πιέστε 'Επίλυση'." Foreground="White" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock x:Name="TxtCurrentExpr" Text="Παράσταση: -" Foreground="#FDE047" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- All Steps Transformation History -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="ΙΣΤΟΡΙΚΟ BΗΜΑΤΩΝ / ΜΕΤΑΣΧΗΜΑΤΙΣΜΩΝ:" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                            <ListBox Grid.Row="1" x:Name="LstSteps" Background="#0F172A" Foreground="#E2E8F0" FontSize="12" BorderThickness="1" BorderBrush="#334155" SelectionChanged="OnStepSelected">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,4">
                                            <TextBlock Text="{Binding ExplanationText}" Foreground="#F8FAFC" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding ExpressionText, StringFormat='➔ {0}'}" Foreground="#818CF8" FontSize="11"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- PLAYBACK CONTROL BAR -->
            <Border Grid.Row="2" Style="{StaticResource CardPanelStyle}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Playback Action Buttons -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="⏮ Πρώτο" Margin="0,0,4,0" Click="OnFirstStepClick"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="◀ Προηγούμενο" Margin="0,0,4,0" Click="OnPrevStepClick"/>
                        <Button x:Name="BtnPlayPause" Style="{StaticResource PrimaryButtonStyle}" Content="▶ Αναπαραγωγή" Margin="0,0,4,0" Click="OnPlayPauseClick"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Επόμενο ▶" Margin="0,0,4,0" Click="OnNextStepClick"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Τελευταίο ⏭" Margin="0,0,12,0" Click="OnLastStepClick"/>
                    </StackPanel>

                    <!-- Progress Slider -->
                    <Slider Grid.Column="1" x:Name="SldSteps" Minimum="0" Maximum="1" Value="0" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnStepSliderChanged"/>

                    <!-- Animation Speed Slider -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Ταχύτητα:" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Slider x:Name="SldSpeed" Width="80" Minimum="0.5" Maximum="3" Value="1" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- VIRTUAL TOUCH KEYBOARD PANEL -->
            <Grid Grid.Row="3" x:Name="GridVirtualKeyboard" Visibility="Visible">
                <controls:VirtualKeyboardControl x:Name="VirtualKeyboard" KeyPressed="OnVirtualKeyPressed" BackspacePressed="OnVirtualBackspacePressed" ClearPressed="OnVirtualClearPressed"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
